//}

void handleGetSentences()
{
  String json = "{";
  for (int i = 0; i < 4; i++)
  {
    if (i > 0) json += ",";

    // Pełne escapowanie: backslash, cudzysłów, i znaki sterujące
    String sent = repeatSentences[i];
    sent.replace("\\", "\\\\");  // najpierw \\
    sent.replace("\"", "\\\"");  // potem "
    sent.replace("\n", "\\n");   // nowy wiersz
    sent.replace("\r", "\\r");   // carriage return
    sent.replace("\t", "\\t");   // tab (na wszelki wypadek)

    json += "\"sent" + String(i) + "\":\"" + sent + "\"";
    json += ",\"intv" + String(i) + "\":" + String(repeatInterval[i]);
    json += ",\"enab" + String(i) + "\":" + (repeatEnabled[i] ? "true" : "false");
  }
  json += "}";

  server.send(200, "application/json", json);
}

