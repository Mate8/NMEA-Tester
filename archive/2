// ================= WEB HANDLERS =================
void handleRoot()
{
  server.sendHeader("Cache-Control", "no-cache, no-store, must-revalidate");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
  server.send(200, "text/html", htmlForm);
}
//void handleLog() {
//  server.sendHeader("Cache-Control", "no-cache");
